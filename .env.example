# Local-only development values. Replace the database password before exposing services.
POSTGRES_USER=viralcut_dev
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=viralcut_dev
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used when running the API directly on Windows; Compose sets service-host URLs itself.
DATABASE_URL=postgresql://viralcut_dev:replace-with-a-local-password@localhost:5432/viralcut_dev
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional hosted providers. Leave blank until configured; keep keys server-side only.
AI_PROVIDER=none
AI_API_KEY=
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=